(ns phel-snake-tests.core.logic-test
  (:require [phel-snake.core.logic :as l]
            [phel.test :refer [deftest is]]))

(def- board {:width 10 :height 10})

(deftest test-step-head
  (is (= {:x 6 :y 5} (l/step-head {:x 5 :y 5} :right)))
  (is (= {:x 4 :y 5} (l/step-head {:x 5 :y 5} :left)))
  (is (= {:x 5 :y 4} (l/step-head {:x 5 :y 5} :up)))
  (is (= {:x 5 :y 6} (l/step-head {:x 5 :y 5} :down))))

(deftest test-turn
  (let [s (l/->Snake :right 0 {:x 5 :y 5} [])]
    (is (= :right (:direction (l/turn s nil))) "nil keeps the direction")
    (is (= :right (:direction (l/turn s :left))) "180° reversal ignored, no self-kill")
    (is (= :up (:direction (l/turn s :up))))))

(deftest test-advance
  (let [s (l/->Snake :right 1 {:x 5 :y 5} [{:x 3 :y 5} {:x 4 :y 5}])]
    (is (= (l/->Snake :right 1 {:x 6 :y 5} [{:x 4 :y 5} {:x 5 :y 5}])
           (l/advance s {:x 6 :y 5} false))
        "the tail follows the head")
    (is (= (l/->Snake :right 1 {:x 6 :y 5} [{:x 3 :y 5} {:x 4 :y 5} {:x 5 :y 5}])
           (l/advance s {:x 6 :y 5} true))
        "growing keeps the tail tip and moves one cell only")
    (is (= [{:x 5 :y 5}] (:tail (l/advance (l/->Snake :right 0 {:x 5 :y 5} []) {:x 6 :y 5} false)))
        "a bare head leaves its first tail cell behind")))

(deftest test-hits-wall?
  (is (false? (l/hits-wall? board {:x 5 :y 5})))
  (is (true?  (l/hits-wall? board {:x 5 :y 0})) "top")
  (is (true?  (l/hits-wall? board {:x 5 :y 9})) "bottom")
  (is (true?  (l/hits-wall? board {:x 10 :y 5})) "right")
  (is (true?  (l/hits-wall? board {:x 1 :y 5})) "left"))

(deftest test-wrap-pos
  (is (= {:x 5 :y 5} (l/wrap-pos board {:x 5 :y 5})) "inside play area => unchanged")
  (is (= {:x 2 :y 5} (l/wrap-pos board {:x 10 :y 5})) "right => left edge")
  (is (= {:x 9 :y 5} (l/wrap-pos board {:x 1 :y 5})) "left => right edge")
  (is (= {:x 5 :y 1} (l/wrap-pos board {:x 5 :y 9})) "bottom => top")
  (is (= {:x 5 :y 8} (l/wrap-pos board {:x 5 :y 0})) "top => bottom"))

(deftest test-next-head
  (let [s (l/->Snake :right 0 {:x 9 :y 5} [])]
    (is (= {:x 10 :y 5} (l/next-head board false s)))
    (is (= {:x 2 :y 5} (l/next-head board true s)) "wraps when asked")))

(deftest test-self-collision?
  (is (false? (l/self-collision? (l/->Snake :right 0 {:x 5 :y 5} []))) "no tail")
  (is (false? (l/self-collision? (l/->Snake :right 0 {:x 5 :y 5} [{:x 4 :y 5} {:x 3 :y 5}]))) "miss")
  (is (true?  (l/self-collision? (l/->Snake :right 0 {:x 3 :y 5} [{:x 4 :y 5} {:x 3 :y 5}]))) "hit"))

(deftest test-on-snake?
  (let [s (l/->Snake :right 0 {:x 5 :y 5} [{:x 4 :y 5}])]
    (is (true?  (l/on-snake? s {:x 5 :y 5})) "head")
    (is (true?  (l/on-snake? s {:x 4 :y 5})) "tail")
    (is (false? (l/on-snake? s {:x 9 :y 9})) "elsewhere")))

(deftest test-snake-cells
  (is (= [{:x 5 :y 5} {:x 4 :y 5} {:x 3 :y 5}]
         (vec (l/snake-cells (l/->Snake :right 0 {:x 5 :y 5} [{:x 4 :y 5} {:x 3 :y 5}]))))
      "head first, then the tail cells"))

(deftest test-goal-bonus
  (is (= {:score-delta 1 :grow? true :slow-ticks 0} (l/goal-bonus :normal)))
  (is (= 5 (:score-delta (l/goal-bonus :golden))) "golden worth 5 points")
  (is (pos? (:slow-ticks (l/goal-bonus :slow))) "slow power-up applies slow-ticks")
  (is (= (l/goal-bonus :normal) (l/goal-bonus :anything-else)) "unknown type falls back to :normal"))

(deftest test-random-free-cell-avoids-blocked
  (php/mt_srand 1)
  (let [tiny    {:width 5 :height 4}
        blocked #{{:x 2 :y 1} {:x 3 :y 1} {:x 2 :y 2}}]
    (is (= {:x 3 :y 2} (l/random-free-cell tiny blocked)) "only one free cell left")
    (is (nil? (l/random-free-cell tiny (conj blocked {:x 3 :y 2}))) "full board => nil")))

(deftest test-generate-goal
  (php/mt_srand 1)
  (let [goal (l/generate-goal board #{} false)]
    (is (= :normal (:type goal)) "power-ups off => normal goal")
    (is (false? (l/hits-wall? board (:pos goal))) "inside the play area")))

(deftest test-generate-obstacles-avoids-snakes
  (php/mt_srand 1)
  (let [big {:width 30 :height 20}
        s1  (l/->Snake :right 0 {:x 5 :y 10} [])
        s2  (l/->Snake :left 0 {:x 25 :y 10} [])
        obs (l/generate-obstacles big [s1 s2] 8)]
    (is (= 8 (count obs)) "places the requested count on a roomy board")
    (is (false? (contains? obs (:head s1))) "never spawns on P1's head")
    (is (false? (contains? obs (:head s2))) "never spawns on P2's head")
    (is (false? (contains? obs {:x 6 :y 10})) "keeps P1's spawn corridor clear")))

(deftest test-spawn-wall-segment
  (php/mt_srand 1)
  (let [cells (l/spawn-wall-segment {:width 30 :height 20} #{} 3)]
    (is (= 3 (count cells)))
    (is (every? #(not (l/hits-wall? {:width 30 :height 20} %)) cells))))

(deftest test-advance-combo
  (let [zero      {:count 0 :ticks-left 0 :multiplier 1}
        first-eat (l/advance-combo zero true)]
    (is (= 1 (:count first-eat)) "first eat starts the combo")
    (is (= 1 (:multiplier first-eat)) "first eat has no multiplier")
    (let [second-eat (l/advance-combo first-eat true)]
      (is (= 2 (:count second-eat)) "second eat within window grows combo")
      (is (= 2 (:multiplier second-eat)) "x2 on second consecutive eat"))
    (let [ticked (l/advance-combo first-eat false)]
      (is (= 1 (:count ticked)) "combo persists while window is open")
      (is (= 1 (:multiplier ticked)) "no multiplier when not eating"))))

(deftest test-advance-combo-expires
  (let [expired (loop [c (l/advance-combo {:count 0 :ticks-left 0} true) n 40]
                  (if (zero? n) c (recur (l/advance-combo c false) (dec n))))]
    (is (= 0 (:count expired)) "combo count resets after window closes")
    (is (= 0 (:ticks-left expired)) "ticks-left clamped to zero")))

(deftest test-advance-combo-multiplier-cap
  (let [eaten-many (loop [c {:count 0 :ticks-left 0} n 20]
                     (if (zero? n) c (recur (l/advance-combo c true) (dec n))))]
    (is (= 5 (:multiplier eaten-many)) "multiplier capped at combo-multiplier-cap (5)")))
