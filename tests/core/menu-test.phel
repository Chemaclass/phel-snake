(ns phel-snake-tests\core\menu-test
  (:require phel-snake\core\menu :refer [toggle-option apply-key row-on? menu-rows fold-menu-events])
  (:require phel\test :refer [deftest is]))

(def- base
  {:two-player? false :wrap? false :obstacle-count 0
   :power-ups? true :levels? true :variable-speed? true})

(deftest test-toggle-boolean-option
  (is (true? ((toggle-option base :wrap?) :wrap?)) "off => on")
  (is (false? ((toggle-option (toggle-option base :wrap?) :wrap?) :wrap?))
      "toggling twice returns to off"))

(deftest test-toggle-obstacles-uses-default-count
  (let [on (toggle-option base :obstacle-count)]
    (is (pos? (on :obstacle-count)) "off => default count, not just 1")
    (is (= 0 ((toggle-option on :obstacle-count) :obstacle-count))
        "toggling again turns obstacles back off")))

(deftest test-apply-key-toggles-matching-row
  (is (true? ((apply-key base "31") :two-player?)) "key 1 toggles the first row")
  (is (true? ((apply-key base "32") :wrap?)) "key 2 toggles the second row"))

(deftest test-apply-key-ignores-unmapped-keys
  (is (= base (apply-key base "0d")) "Enter leaves config unchanged")
  (is (= base (apply-key base "39")) "a number past the last row is a no-op"))

(deftest test-row-on?-reads-obstacle-count
  (let [row {:key :obstacle-count}]
    (is (false? (row-on? base row)) "count 0 reads as off")
    (is (true? (row-on? (assoc base :obstacle-count 10) row)) "positive count reads as on")))

(deftest test-fold-menu-events-toggle-then-start
  (let [{:config cfg :outcome outcome}
        (fold-menu-events base [{:hex "31"} {:hex "0d"}])]
    (is (= :start outcome) "a batched \"1 then Enter\" starts the game")
    (is (true? (cfg :two-player?)) "and the number toggle applied before starting")))

(deftest test-fold-menu-events-start-wins-over-later-keys
  (let [{:config cfg :outcome outcome}
        (fold-menu-events base [{:hex "0d"} {:hex "32"}])]
    (is (= :start outcome) "Enter starts immediately")
    (is (false? (cfg :wrap?)) "keys after the start key are ignored")))

(deftest test-fold-menu-events-quit
  (is (= :quit ((fold-menu-events base [{:hex "71"}]) :outcome)) "q quits"))

(deftest test-fold-menu-events-idle
  (let [{:outcome outcome} (fold-menu-events base [])]
    (is (nil? outcome) "no events => no outcome, keep polling")))
