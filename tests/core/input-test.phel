(ns phel-snake-tests.core.input-test
  (:require [phel-snake.core.input :as input]
            [phel.test :refer [deftest is]]))

(deftest test-split-keys
  (is (= [] (input/split-keys "")) "empty buffer => no keys")
  (is (= ["w"] (input/split-keys "w")))
  (is (= ["\e[A"] (input/split-keys "\e[A")) "3-byte CSI sequence is one key")
  (is (= ["w" "\e[C" "s"] (input/split-keys "w\e[Cs")))
  (is (= ["\e" "["] (input/split-keys "\e[")) "a truncated sequence splits into bytes"))

(deftest test-last-direction
  (is (nil? (input/last-direction input/wasd-directions [])) "no keys => nil")
  (is (= :left (input/last-direction input/wasd-directions ["w" "s" "a"])) "last direction wins")
  (is (= :up (input/last-direction input/wasd-directions ["w" "x" "?"])) "unmapped keys don't overwrite"))

(deftest test-directions
  (let [keys (input/split-keys "\e[Bd")]
    (is (= [:down] (input/directions 1 keys)) "solo reads the arrows only")
    (is (= [:down :right] (input/directions 2 keys)) "P2 reads WASD")))

(deftest test-pressed?
  (is (true? (input/pressed? ["a" " "] input/accelerate-key)))
  (is (false? (input/pressed? ["a"] input/pause-key))))

(deftest test-replay-key?
  (is (true? (input/replay-key? "r")))
  (is (true? (input/replay-key? "R")))
  (is (false? (input/replay-key? "x")))
  (is (false? (input/replay-key? nil))))
