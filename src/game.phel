(ns phel-snake.game
  (:require [phel-snake.core.engine :as engine]
            [phel-snake.core.input :as input]
            [phel-snake.core.render :as render]
            [phel-snake.highscore :as highscore]
            [phel-snake.terminal :as term]))

(defn- ^int elapsed-secs [^float start]
  (int (php/round (- (php/microtime true) start))))

(defn- sleep-remaining
  "Sleeps `target-us` minus the time already spent since `frame-start`, so
  per-frame work doesn't stretch the frame period."
  [^float frame-start ^int target-us]
  (let [spent-us (int (* 1000000 (- (php/microtime true) frame-start)))]
    (when (> target-us spent-us)
      (php/usleep (- target-us spent-us)))))

(defn- wait-while-paused [board]
  (term/write! (render/banner board ["PAUSED"]))
  (loop []
    (when-not (input/pressed? (input/split-keys (term/wait-input)) input/pause-key)
      (recur))))

(defn- play-session
  "Runs one game until a snake crashes. With `replay` ({:seed :inputs}) it
  re-runs that recorded game; the inputs and seed of this run come back for
  the next replay."
  [{:keys [board] :as config} replay]
  (let [seed (or (:seed replay) (php/mt_rand 0 1000000))]
    (php/mt_srand seed)
    (let [start      (php/microtime true)
          replaying? (some? replay)]
      (loop [prev     nil
             state    (engine/init-state config)
             queued   (:inputs replay)
             recorded []]
        (let [frame-start (php/microtime true)]
          (term/write-frame! (render/frame config prev state (elapsed-secs start)))
          (sleep-remaining frame-start (engine/frame-delay config state)))
        (if-let [outcome (engine/outcome config state)]
          {:outcome outcome :state state :elapsed (elapsed-secs start)
           :replay {:seed seed :inputs recorded}}
          (let [raw     (if replaying? (or (first queued) "") (term/read-available))
                keys    (input/split-keys raw)
                paused? (and (not replaying?) (input/pressed? keys input/pause-key))]
            (when paused? (wait-while-paused board))
            (recur (when-not paused? state)
                   (engine/tick config state
                                (input/directions (count (:players state)) keys)
                                (input/pressed? keys input/accelerate-key))
                   (rest queued)
                   (conj recorded raw))))))))

(defn- solo-summary [{:keys [state elapsed]}]
  (let [score                                 (get-in state [:players 0 :snake :score])
        {prev :previous record? :new-record?} (highscore/update-if-higher score)]
    {:banner ["GAME OVER" (format "Score: %d" score)]
     :lines  [(format "Final Score: %d points" score)
              (format "Total Time: %d secs" elapsed)
              (if record?
                (format "NEW HIGH SCORE! (previous: %d)" prev)
                (format "High Score: %d" prev))]}))

(defn- duel-summary [{:keys [outcome state elapsed]}]
  (let [[s1 s2] (engine/snakes state)]
    {:banner [(case outcome
                :p1 "PLAYER 1 WINS"
                :p2 "PLAYER 2 WINS"
                "DRAW")]
     :lines  [(format "P1 Score: %d | P2 Score: %d" (:score s1) (:score s2))
              (format "Total Time: %d secs" elapsed)]}))

(defn- finish
  "Shows the result. Returns true when the player asked for a replay."
  [{:keys [board]} session replay-offered?]
  (let [{:keys [banner lines]} (if (= :game-over (:outcome session))
                                 (solo-summary session)
                                 (duel-summary session))
        prompt                 (if replay-offered?
                                 "Press R to replay, any other key to exit..."
                                 "Press any key to exit...")]
    (term/read-available)
    (term/write! (str (render/banner board banner)
                      (render/messages board (conj lines "" prompt))))
    (let [key (first (input/split-keys (term/wait-input)))]
      (and replay-offered? (input/replay-key? key)))))

(defn run [config]
  (term/init!)
  (loop [replay nil]
    (let [session (play-session config replay)]
      (when (finish config session (and (nil? replay) (engine/solo? (:state session))))
        (recur (:replay session))))))
