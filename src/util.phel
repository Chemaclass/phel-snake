(ns phel-snake.util)

(defn get-int-arg
  "Returns the int value of `name=N` in args, or default if absent."
  [args arg-name default]
  (let [prefix (str arg-name "=")]
    (if-let [arg (find #(php/str_starts_with % prefix) args)]
      (php/intval (php/substr arg (php/strlen prefix)))
      default)))
