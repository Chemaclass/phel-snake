(ns phel-snake\core\menu
  (:require [phel-cli-gui\terminal-gui :as gui]
            [phel-snake\config :refer [default-obstacle-count]]
            [phel-snake\core\input :refer [parse-input-events]]))

(def menu-rows
  "Toggleable options, in display order. `:key` is the config key each row flips."
  [{:key :two-player?     :label "Two players (arrows vs WASD)"}
   {:key :wrap?           :label "Wrap around walls"}
   {:key :obstacle-count  :label "Obstacles"}
   {:key :power-ups?      :label "Power-ups (golden / slow goals)"}
   {:key :levels?         :label "Level walls"}
   {:key :variable-speed? :label "Speed ramps with score"}])

(defn row-on?
  "Whether `row`'s option is currently enabled in `config`."
  [config {:key k}]
  (if (= k :obstacle-count)
    (pos? (config k))
    (config k)))

(defn toggle-option
  "Flip one option. Obstacles toggle between off and the default count; every
  other row is a boolean."
  [config k]
  (if (= k :obstacle-count)
    (update config k (fn [n] (if (pos? n) 0 default-obstacle-count)))
    (update config k not)))

(def- key->row-index
  {"31" 0 "32" 1 "33" 2 "34" 3 "35" 4 "36" 5})

(defn apply-key
  "Apply a keypress (as a hex string) to the menu config. Number keys toggle the
  matching row; anything else leaves the config unchanged."
  [config hex]
  (let [i (get key->row-index hex)]
    (if (and i (< i (count menu-rows)))
      (toggle-option config ((nth menu-rows i) :key))
      config)))

(def- key-enter-hex "0d")
(def- key-space-hex "20")
(def- key-q-hex     "71")
(def- key-Q-hex     "51")

(defn- start? [hex] (or (= hex key-enter-hex) (= hex key-space-hex)))
(defn- quit?  [hex] (or (= hex key-q-hex) (= hex key-Q-hex)))

(defn- checkbox [on?] (if on? "[x]" "[ ]"))

(defn- render-menu [config]
  (gui/clear-screen)
  (println "   S N A K E")
  (println)
  (println "   Press a number to toggle, Enter to start, q to quit.")
  (println)
  (loop [i 0]
    (when (< i (count menu-rows))
      (let [row (nth menu-rows i)]
        (println (format "     %d. %s %s"
                         (inc i)
                         (checkbox (row-on? config row))
                         (row :label))))
      (recur (inc i))))
  (println))

(defn fold-menu-events
  "Fold a tick's key events into {:config :outcome}, where :outcome is :start,
  :quit, or nil. Number keys toggle rows in order; the first start/quit key
  wins and ignores the rest. Draining the buffer keeps the menu responsive to
  fast or pasted input (a batched \"1<Enter>\" toggles then starts)."
  [config events]
  (reduce
    (fn [{:config cfg :outcome outcome :as acc} {:hex hex}]
      (cond
        outcome      acc
        (start? hex) {:config cfg :outcome :start}
        (quit? hex)  {:config cfg :outcome :quit}
        :else        {:config (apply-key cfg hex) :outcome nil}))
    {:config config :outcome nil}
    events))

(defn show-menu
  "Interactive start screen. Returns the chosen config when the player starts,
  or exits on quit. Polls non-blocking input and repaints only after a change,
  so an idle menu doesn't flicker."
  [config]
  (render-menu config)
  (loop [config config]
    (let [events (parse-input-events (get (gui/read-input 8) :raw))]
      (if (empty? events)
        (do (php/usleep 60000) (recur config))
        (let [{:config next-config :outcome outcome} (fold-menu-events config events)]
          (case outcome
            :start next-config
            :quit  (php/exit)
            (do (render-menu next-config) (recur next-config))))))))
