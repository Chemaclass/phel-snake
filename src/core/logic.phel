(ns phel-snake.core.logic)

(defrecord Snake [direction score head tail])

(def direction-vectors
  {:left  {:dx -1 :dy 0}
   :right {:dx  1 :dy 0}
   :up    {:dx  0 :dy -1}
   :down  {:dx  0 :dy  1}})

(def- opposite-direction
  {:left :right :right :left :up :down :down :up})

(def- left-wall-x 1)
(def- top-wall-y  0)
(def- spawn-width 5)

(def combo-window-ticks 30)
(def combo-multiplier-cap 5)
(def- random-attempt-limit 50)
(def- spawn-wall-attempt-limit 30)
(def- snake-spawn-corridor 7)
(def- obstacle-attempt-multiplier 20)

(def- wall-dirs [{:dx 1 :dy 0} {:dx -1 :dy 0} {:dx 0 :dy 1} {:dx 0 :dy -1}])

(defn step-head
  "New head position moved one cell in `direction`."
  [{:keys [x y]} direction]
  (let [{:keys [dx dy]} (direction-vectors direction)]
    {:x (+ x dx) :y (+ y dy)}))

(defn turn
  "Points the snake at `requested`. nil keeps the current direction, and so
  does a 180° reversal: the head would step onto its own neck and die."
  [{current :direction :as s} requested]
  (if (or (nil? requested) (= requested (opposite-direction current)))
    s
    (assoc s :direction requested)))

(defn advance
  "Moves the head to `head`. The tail follows, or keeps its tip when `grow?`."
  [{:keys [tail] old-head :head :as s} head grow?]
  (assoc s
         :head head
         :tail (conj (if (or grow? (empty? tail)) tail (subvec tail 1)) old-head)))

(defn hits-wall?
  "True when `pos` is on or beyond the board border."
  [{w :width h :height} {:keys [x y]}]
  (or (<= x left-wall-x)
      (<= y top-wall-y)
      (>= x w)
      (>= y (dec h))))

(defn- inside-play-area?
  [{w :width h :height} {:keys [x y]}]
  (and (> x left-wall-x)
       (> y top-wall-y)
       (< x (dec w))
       (< y (dec h))))

(defn wrap-pos
  "Wraps `pos` to the opposite wall when it crosses the play-area boundary."
  [{w :width h :height} {:keys [x y] :as pos}]
  (let [min-x (inc left-wall-x)
        max-x (dec w)
        min-y (inc top-wall-y)
        max-y (- h 2)
        wx    (cond (> x max-x) min-x (< x min-x) max-x :else x)
        wy    (cond (> y max-y) min-y (< y min-y) max-y :else y)]
    (if (and (= wx x) (= wy y)) pos {:x wx :y wy})))

(defn next-head
  "Where the head lands on the next move, wrapped when `wrap?`."
  [board wrap? {:keys [head] d :direction}]
  (let [pos (step-head head d)]
    (if wrap? (wrap-pos board pos) pos)))

(defn snake-cells
  "Seq of `{:x :y}` cells the snake occupies (head first, then tail)."
  [{:keys [head tail]}]
  (cons head tail))

(defn ^bool same-cell?
  "Compares coordinates only, which is cheaper than map equality."
  [a b]
  (and (= (:x a) (:x b)) (= (:y a) (:y b))))

(defn- ^bool any-cell? [cells pos]
  (let [x (:x pos) y (:y pos)]
    (reduce (fn [_ c] (if (and (= x (:x c)) (= y (:y c))) (reduced true) false))
            false
            cells)))

(defn on-snake?
  "True when `pos` is any cell of the snake."
  [{:keys [head tail]} pos]
  (or (same-cell? head pos) (any-cell? tail pos)))

(defn self-collision?
  "True when the snake head overlaps any cell of its own tail."
  [{:keys [head tail]}]
  (any-cell? tail head))

(defn random-goal-type
  "Picks a goal type weighted toward :normal. ~8% :golden, ~8% :slow."
  []
  (let [r (rand-int 100)]
    (cond (< r 8)  :golden
          (< r 16) :slow
          :else    :normal)))

(defn goal-bonus
  "Effect granted by consuming a goal of the given type."
  [type]
  (case type
    :golden {:score-delta 5 :grow? true :slow-ticks 0}
    :slow   {:score-delta 2 :grow? true :slow-ticks 40}
    {:score-delta 1 :grow? true :slow-ticks 0}))

(defn- random-cell [{w :width h :height}]
  {:x (rand-int w) :y (rand-int h)})

(defn- free? [board blocked pos]
  (and (inside-play-area? board pos) (not (contains? blocked pos))))

(defn- free-cells [{w :width h :height :as board} blocked]
  (for [x :range [(inc left-wall-x) (dec w)]
        y :range [(inc top-wall-y) (dec h)]
        :let [pos {:x x :y y}]
        :when (free? board blocked pos)]
    pos))

(defn random-free-cell
  "Random play-area cell outside `blocked` (a set of cells), or nil when the
  board is full. Samples first and falls back to a full scan on crowded boards."
  [board blocked]
  (loop [attempts 0]
    (let [pos (random-cell board)]
      (cond
        (free? board blocked pos)         pos
        (< attempts random-attempt-limit) (recur (inc attempts))
        :else                             (let [free (vec (free-cells board blocked))]
                                            (when-not (empty? free) (rand-nth free)))))))

(defn random-spawn
  "Random starting head position near the left side of the board."
  [{h :height}]
  (random-free-cell {:width spawn-width :height h} #{}))

(defn generate-goal
  "Goal on a free cell, or nil when none is left. With `power-ups?` its :type
  is random, otherwise :normal."
  [board blocked power-ups?]
  (when-let [pos (random-free-cell board blocked)]
    {:pos pos :type (if power-ups? (random-goal-type) :normal)}))

(defn- spawn-corridor [{:keys [head] d :direction}]
  (let [{:keys [dx dy]} (direction-vectors d)]
    (for [i :range [1 snake-spawn-corridor]]
      {:x (+ (:x head) (* i dx))
       :y (+ (:y head) (* i dy))})))

(defn generate-obstacles
  "Set of `n` random obstacle cells, avoiding every snake and the corridor in
  front of each so spawning isn't an instant death. May return fewer on a
  crowded board."
  [board snakes n]
  (let [limit (* n obstacle-attempt-multiplier)]
    (loop [obstacles #{}
           blocked   (into #{} (mapcat #(concat (snake-cells %) (spawn-corridor %))) snakes)
           attempts  0]
      (if (or (= (count obstacles) n) (>= attempts limit))
        obstacles
        (let [pos (random-cell board)]
          (if (free? board blocked pos)
            (recur (conj obstacles pos) (conj blocked pos) 0)
            (recur obstacles blocked (inc attempts))))))))

(defn- wall-cells [start {:keys [dx dy]} len]
  (for [i :range [0 len]]
    {:x (+ (:x start) (* i dx))
     :y (+ (:y start) (* i dy))}))

(defn spawn-wall-segment
  "`len` contiguous free cells in a random direction. Returns `[]` if no spot found."
  [board blocked len]
  (loop [attempts 0]
    (if (>= attempts spawn-wall-attempt-limit)
      []
      (let [cells (wall-cells (random-cell board) (rand-nth wall-dirs) len)]
        (if (every? #(free? board blocked %) cells)
          cells
          (recur (inc attempts)))))))

(defn advance-combo
  "One combo tick. `ate?` is true when a goal was consumed.
  Returns `{:count :ticks-left :multiplier}`; `:multiplier` applies to the
  score delta for this tick (1 if no eat)."
  [{c :count t :ticks-left} ate?]
  (cond
    ate?
    (let [new-count (if (pos? t) (inc c) 1)]
      {:count      new-count
       :ticks-left combo-window-ticks
       :multiplier (min combo-multiplier-cap new-count)})
    (pos? t)
    (let [nt (dec t)]
      {:count      (if (pos? nt) c 0)
       :ticks-left nt
       :multiplier 1})
    :else
    {:count 0 :ticks-left 0 :multiplier 1}))
