(ns phel-snake.core.input)

(def arrow-directions
  {"\e[A" :up "\e[B" :down "\e[C" :right "\e[D" :left})

(def wasd-directions
  {"w" :up "s" :down "a" :left "d" :right})

(def player-controls [arrow-directions wasd-directions])

(def accelerate-key " ")
(def pause-key "p")

(defn split-keys
  "Splits a raw stdin buffer into keys: a 3-byte CSI sequence (ESC [ x, the
  arrows) or a single byte."
  [^string raw]
  (let [len (php/strlen raw)]
    (loop [i 0 keys []]
      (if (>= i len)
        keys
        (let [n (if (and (<= (+ i 3) len) (= "\e[" (php/substr raw i 2))) 3 1)]
          (recur (+ i n) (conj keys (php/substr raw i n))))))))

(defn pressed?
  "True when `key` is among `keys`."
  [keys key]
  (boolean (some #(= key %) keys)))

(defn replay-key? [key]
  (or (= "r" key) (= "R" key)))

(defn last-direction
  "The last direction `controls` maps from `keys`, or nil."
  [controls keys]
  (last (keep controls keys)))

(defn directions
  "Each player's requested direction, reading its own controls."
  [player-count keys]
  (mapv #(last-direction % keys) (take player-count player-controls)))
