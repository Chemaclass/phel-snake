(ns phel-snake.core.input)

(def arrow-directions
  {"\e[A" :up "\e[B" :down "\e[C" :right "\e[D" :left})

(def wasd-directions
  {"w" :up "s" :down "a" :left "d" :right})

(def player-controls [arrow-directions wasd-directions])

(def accelerate-key " ")
(def pause-key "p")

(defn split-keys
  "Splits a raw stdin buffer into keys: a 3-byte CSI sequence (ESC [ x, the
  arrows) or a single byte."
  [^string raw]
  (let [len (php/strlen raw)]
    (loop [i 0 found []]
      (if (>= i len)
        found
        (let [n (if (and (<= (+ i 3) len) (= "\e[" (php/substr raw i 2))) 3 1)]
          (recur (+ i n) (conj found (php/substr raw i n))))))))

(defn pressed?
  "True when `pressed` is among `held`."
  [held pressed]
  (boolean (some #(= pressed %) held)))

(defn replay-key? [pressed]
  (or (= "r" pressed) (= "R" pressed)))

(defn last-direction
  "The last direction `controls` maps from `held`, or nil."
  [controls held]
  (last (keep controls held)))

(defn directions
  "Each player's requested direction, reading its own controls."
  [player-count held]
  (mapv #(last-direction % held) (take player-count player-controls)))
